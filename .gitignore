# Secrets. The example file is the only env file that belongs in git.
.env
.env.*
!.env.example

# Virtual environments and Python caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases, vector indexes, and memory
*.db
*.sqlite
*.sqlite3
chroma_db/
.chroma/
workspace/
storage/
youtube_token.json

# Runtime folders. The empty markers stay so the tree exists after clone.
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
temp/*
!temp/.gitkeep

# Recordings, renders, and archives
*.ogg
*.oga
*.opus
*.wav
*.mp3
*.mp4
*.jpg
*.jpeg
*.png
*.zip
*.7z
*.rar

# Local config that can hold personal paths or contacts
gta5_path.json
contacts.json
routines.json
mcp_servers.json

# Stage 2: recorded actions can contain typed text; remote token
skills/*/actions.json
skills/*/frames/
remote_token.txt
bots/
!app_static/*.png

# Personal runtime data (never commit)
rules.local.yaml
ui_settings.json
remote_token.txt
*.jks
*.keystore
android_app/build/
groups/
bots/
dist/
*.bak*
bak-*/

!docs/*.png
!app_static/avatars/*.png
*.jks.b64
*.p12
keystore-backup/
