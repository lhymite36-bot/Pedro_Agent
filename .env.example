# AI Models & APIs
# Required for online chat. Leave empty and set PRIVACY_MODE=1 to stay on a local model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Spoken replies. With a key, the voice is a male cloud voice. With no key, speech stays on edge-tts.
ELEVENLABS_API_KEY=
# Male voice id. Default is George, JBFqnCBsd6RMkjVDRZzb.
# Adam is pNInz6obpgDQGcFmaJgB. Drew is 29vD33N1CtxCmqQRPOHJ.
VOICE_ID=
# eleven_v3 performs reaction tags. eleven_multilingual_v2 is the other choice.
ELEVENLABS_MODEL=
# Low-latency fallbacks. Used when the lines above are empty or that call fails.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=

# Telegram Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A voice note is transcribed and the text answer is sent back.
# Leave empty for no reaction. A thumbs-up or robot emoji adds one.
TELEGRAM_VOICE_REACTION=
DISCORD_WEBHOOK_URL=

# System Paths & External Storage
# New clones keep indexes under ./storage. Leave STORAGE_DIR empty to use ./workspace.
STORAGE_DIR=./storage
# Folder of an external drive, or leave empty and set the volume name below.
EXTERNAL_DRIVE_PATH=
EXTERNAL_DRIVE_LABEL=

# Media and browser
FFMPEG_EXECUTABLE=
# Optional login for browser_download_tool. Pass the name BROWSER_PASSWORD
# in the tool call. Do not paste the value into chat.
BROWSER_USERNAME=
BROWSER_PASSWORD=
# Set BLENDER_EXECUTABLE when blender is not on PATH.
BLENDER_EXECUTABLE=

# Local model when a request stays on this PC. Ollama must be running.
OLLAMA_MODEL=llama3.2
# Set to 1 to answer every turn with Ollama instead of Gemini.
PRIVACY_MODE=
LOCAL_LLM=
# Seconds without keyboard or mouse input before idle tasks. Default 300.
IDLE_TASK_SECONDS=
# Quiet minutes before a voice-mode check-in. Clamped from 15 to 30.
CHECKIN_IDLE_MINUTES=
# Wake phrase. Default is "hey agent".
WAKE_PHRASE=
# Local male voice used when no speech key is set. Default is en-US-AndrewNeural.
EDGE_TTS_VOICE=
# Optional path to workspace/mcp_servers.json.
MCP_CONFIG=

# Live video. Leave the RTMP lines empty to use the local viewer.
# The stream key stays in this file. Do not paste it into chat.
TELEGRAM_RTMP_URL=
TELEGRAM_STREAM_KEY=
# Public https origin for a Telegram Mini App button, such as https://your-host
# An http address is sent as a link. Mini Apps need https.
LIVE_PUBLIC_URL=
# Port for the local viewer. Default 8765. It listens only while a feed is on.
LIVE_VIDEO_PORT=
# How long a live feed stays on. Default 120. Maximum 600.
LIVE_STREAM_SECONDS=

# Gmail. Use an app password, not the normal account password.
# Do not paste the app password into chat.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# YouTube uploads. An API key cannot post a video.
# Enable YouTube Data API v3, then create an OAuth desktop client:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# https://console.cloud.google.com/apis/credentials
# Leave these empty until that client exists. Do not paste them into chat.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
